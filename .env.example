# Canonical origin used for canonicals, OpenGraph, sitemap and RSS.
NEXT_PUBLIC_SITE_URL="https://bisheshbhattarai.com"

# ── Back office (/admin) ──────────────────────────────────────────
# Password for the writing portal. Required for /admin to open at all.
ADMIN_PASSWORD=""
# Optional. Signs the session cookie. If unset, a key is derived from
# ADMIN_PASSWORD, so changing the password signs you out everywhere.
ADMIN_SESSION_SECRET=""

# ── Writing assist ────────────────────────────────────────────────
# https://platform.deepseek.com — server-side only, never sent to the browser.
DEEPSEEK_API_KEY=""
# Optional overrides.
DEEPSEEK_MODEL="deepseek-chat"
DEEPSEEK_BASE_URL="https://api.deepseek.com"

# ── Newsletter ────────────────────────────────────────────────────
# Set ONE of these groups. With none set, signups are written to
# .data/subscribers.json in development and refused in production.
BUTTONDOWN_API_KEY=""
# CONVERTKIT_API_KEY=""
# CONVERTKIT_FORM_ID=""
# RESEND_API_KEY=""
# RESEND_AUDIENCE_ID=""

# ── Passport (/passport) ──────────────────────────────────────────
# Vercel Blob holds passport entries and photos. In Vercel: Storage →
# Create → Blob, connect it to this project, and this is set for you.
# Without it, development saves to .data/ and public/uploads/ instead.
BLOB_READ_WRITE_TOKEN=""
